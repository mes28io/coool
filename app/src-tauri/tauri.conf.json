{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "coool",
  "mainBinaryName": "coool",
  "version": "0.4.7",
  "identifier": "sh.coool.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "coool",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 24 },
        "backgroundColor": "#171717",
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "sounds/coool-rise.wav": "coool-rise.wav",
      "sounds/coool-tap.wav": "coool-tap.wav",
      "sounds/coool-glass.wav": "coool-glass.wav",
      "sounds/coool-knock.wav": "coool-knock.wav",
      "sounds/coool-marimba.wav": "coool-marimba.wav",
      "sounds/coool-chirp.wav": "coool-chirp.wav",
      "sounds/coool-ticks.wav": "coool-ticks.wav"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
