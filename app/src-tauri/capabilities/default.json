{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The app's own webview only. Scoped by webview label, not window: a window capability also covers every child webview of that window, and the in-app browser's child webviews (labels browser-*, remote pages) must get nothing. No `remote` section, so no remote origin is granted anything either. The app's own commands are checked against this too (build.rs hands Tauri an app manifest made from generate_handler!, and fails the build if one of them isn't listed below), so no other webview can call them, whatever page it shows: preview-*, browser-*, popup-* and any future one get nothing.",
  "webviews": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-show",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-background-color",
    "dialog:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://claude.ai/*"
        }
      ]
    },
    "allow-changes-load", "allow-changes-undo", "allow-changes-keep", "allow-changes-told", "allow-changes-commit", "allow-changes-preview", "allow-changes-open",
    "allow-attach-paths", "allow-attach-bytes", "allow-attach-image", "allow-attach-preview", "allow-attach-reveal",
    "allow-list-sessions", "allow-spawn-session", "allow-resume-session", "allow-pty-write", "allow-pty-resize",
    "allow-pty-replay", "allow-send-prompt", "allow-stop-session", "allow-stop-shell", "allow-shells-focus",
    "allow-start-chat", "allow-chat-send", "allow-chat-interrupt", "allow-chat-steer", "allow-chat-steer-cancel",
    "allow-chat-set-model", "allow-chat-set-permission-mode", "allow-chat-respond-permission",
    "allow-chat-respond-question", "allow-chat-stop", "allow-chat-replay", "allow-open-in-terminal",
    "allow-insights-status", "allow-insights-set-key", "allow-insights-clear-key", "allow-insights-set-enabled",
    "allow-explain-request", "allow-rename-session", "allow-set-show-automation", "allow-pilot-log-status",
    "allow-pilot-log-set-enabled", "allow-pilot-log-reveal", "allow-pilot-log-delete", "allow-usage-refresh",
    "allow-usage-reset-codex", "allow-pick-folder", "allow-environment", "allow-git-trail", "allow-context-map", "allow-chat-context", "allow-chat-context-read",
    "allow-chat-context-save", "allow-chat-context-create", "allow-chat-context-trash", "allow-chat-context-reveal",
    "allow-folders-index", "allow-folders-list", "allow-folders-complete", "allow-folders-summary", "allow-folders-create", "allow-worktree-create",
    "allow-running-count", "allow-quit-app", "allow-prefs-get", "allow-prefs-set", "allow-power-status",
    "allow-lid-status", "allow-lid-install", "allow-lid-remove", "allow-lid-restore", "allow-lid-simulate",
    "allow-lid-helper-log", "allow-notify-permission", "allow-notify-request", "allow-notify-test",
    "allow-notify-take", "allow-notify-sounds", "allow-notify-sound-preview",
    "allow-voice-status", "allow-voice-permission", "allow-voice-permission-request", "allow-voice-open-privacy",
    "allow-voice-devices", "allow-voice-start", "allow-voice-stop", "allow-voice-cancel", "allow-voice-preload",
    "allow-voice-models", "allow-voice-model-download", "allow-voice-model-pause", "allow-voice-model-cancel",
    "allow-voice-model-delete", "allow-voice-model-check", "allow-voice-memory-read", "allow-voice-memory-write",
    "allow-voice-memory-clear", "allow-voice-reveal", "allow-voice-project-words", "allow-voice-spell",
    "allow-voice-polish", "allow-voice-selftest-inject", "allow-voice-selftest-keys", "allow-voice-keys", "allow-voice-selftest-counters",
    "allow-voice-selftest-transcribe", "allow-voice-selftest-env",
    "allow-login-status", "allow-login-set", "allow-apps-installed", "allow-open-path", "allow-open-system-settings",
