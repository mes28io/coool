    "allow-artifact-status", "allow-artifact-window",
    "allow-browser-open", "allow-browser-bounds", "allow-browser-navigate", "allow-browser-go", "allow-browser-poll",
    "allow-browser-close", "allow-browser-open-external",
    "allow-sim-devices", "allow-sim-ensure-device", "allow-sim-boot", "allow-sim-shutdown", "allow-sim-attach",
    "allow-sim-detach", "allow-sim-input", "allow-sim-bind",
    "allow-mac-status", "allow-mac-install", "allow-mac-boot", "allow-mac-shutdown", "allow-mac-attach",
    "allow-mac-detach", "allow-mac-input", "allow-mac-bind", "allow-mac-network",
    "allow-device-grants", "allow-device-grants-revoke", "allow-browser-agent-sync", "allow-browser-presence-end",
