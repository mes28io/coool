    "allow-selftest-config", "allow-selftest-log", "allow-selftest-chat-launch", "allow-selftest-ladder", "allow-selftest-shot", "allow-selftest-film",
    "allow-selftest-window", "allow-selftest-perf-stats", "allow-selftest-menubar", "allow-selftest-request-quit", "allow-selftest-artifact",
