    "allow-selftest-popups", "allow-selftest-browser-eval", "allow-selftest-page-cursors",
    "allow-selftest-browser-tool", "allow-selftest-page-marks", "allow-selftest-previews",
    "allow-selftest-preview-eval", "allow-selftest-close-preview", "allow-selftest-local-ipc", "allow-selftest-click", "allow-selftest-drag",
    "allow-selftest-native", "allow-selftest-sim-delete", "allow-selftest-mac-install-requests",
    "allow-selftest-sim-screen", "allow-selftest-pilot-log", "allow-selftest-mac", "allow-selftest-mac-screen",
    "allow-selftest-pilot", "allow-selftest-vm", "allow-selftest-mac-tool", "allow-selftest-vm-helper",
    "allow-selftest-device-tool", "allow-selftest-notify", "allow-selftest-notify-click", "allow-selftest-notify-post", "allow-update-status", "allow-update-check", "allow-update-set-auto", "allow-update-install", "allow-update-cli-now", "allow-update-restart", "allow-update-launch-skip", "allow-update-welcome",
    "allow-remote-status", "allow-remote-set-enabled", "allow-remote-pair-start", "allow-remote-pair-confirm",
    "allow-remote-pair-cancel", "allow-remote-remove-device", "allow-remote-set-defaults",
    "allow-remote-set-need-notes", "allow-remote-voice-run", "allow-remote-voice-done", "allow-remote-selftest-read",
